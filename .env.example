# National Research Platform (NRP) LLM token from https://nrp.ai/llmtoken
# Keep the variable name OPENAI_API_KEY so the OpenAI Python SDK and Agents SDK
# pick it up automatically.
OPENAI_API_KEY=your_nrp_llm_token

# NRP Envoy AI Gateway (OpenAI-compatible Chat Completions API)
OPENAI_BASE_URL=https://ellm.nrp-nautilus.io/v1

# Default chat model when an example does not set Agent(model=...)
# Catalog: https://nrp.ai/documentation/userdocs/ai/llm-managed/models
OPENAI_DEFAULT_MODEL=gpt-oss

# Optional overrides used by embedding / vision examples
# NRP_EMBEDDING_MODEL=qwen3-embedding
# NRP_VISION_MODEL=qwen3-small
